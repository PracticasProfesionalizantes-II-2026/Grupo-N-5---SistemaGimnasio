@{
    ViewData["Title"] = "Publicar anuncio";
    var profesores = ViewBag.Profesores as List<ProfesorDto> ?? new();
}
<h1 class="mb-4">Publicar anuncio</h1>
@if (ViewBag.Error != null) { <div class="alert alert-danger">@ViewBag.Error</div> }
<form method="post" asp-action="Create">
    <div class="mb-3"><label class="form-label">Título</label><input type="text" name="Titulo" class="form-control" maxlength="70" required /></div>
    <div class="mb-3"><label class="form-label">Descripción</label><textarea name="Descripcion" class="form-control" maxlength="500" required></textarea></div>
    <div class="mb-3"><label class="form-label">Fecha de publicación</label><input type="date" name="FechaPublicacion" class="form-control" required /></div>
    <div class="mb-3">
        <label class="form-label">Profesor / responsable</label>
        <select name="ProfesorId" class="form-select" required>
            <option value="">-- Seleccionar --</option>
            @foreach (var p in profesores) { <option value="@p.Id">@p.Nombre @p.Apellido</option> }
        </select>
    </div>
    <button type="submit" class="btn btn-dark">Publicar</button>
    <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
</form>
