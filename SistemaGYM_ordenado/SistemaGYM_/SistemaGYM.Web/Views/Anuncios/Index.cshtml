@model List<AnuncioDto>
@{
    ViewData["Title"] = "Anuncios";
    var esAdmin = Context.Session.GetString("Rol") == "Administrador";
    var usuarioId = int.Parse(Context.Session.GetString("UserId") ?? "0");
    var profesores = (ViewBag.Profesores as List<ProfesorDto> ?? new())
        .ToDictionary(p => p.Id, p => $"{p.Nombre} {p.Apellido}");
}
<div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-4">
    <h1 class="mb-0 gym-titulo"><partial name="_Icono" model='"anuncios"' />Anuncios publicados</h1>
    <a asp-action="Create" class="btn btn-dark">+ Publicar anuncio</a>
</div>
@if (!Model.Any())
{
    <div class="alert alert-info">No hay anuncios publicados.</div>
}
else
{
    @* Los anuncios se muestran como un muro de publicaciones, con la fecha a la izquierda *@
    <div class="gym-muro">
    @foreach (var a in Model)
    {
        <div class="gym-publicacion">
            <div class="gym-publicacion-fecha">
                <strong>@a.FechaPublicacion.ToString("dd")</strong>
                <span>@a.FechaPublicacion.ToString("MMM", new System.Globalization.CultureInfo("es-AR"))</span>
            </div>
            <div class="flex-grow-1">
                <strong>@a.Titulo</strong>
                <div class="small text-muted">Publicado por @(profesores.TryGetValue(a.ProfesorId, out var autor) ? autor : "profesor dado de baja")</div>
                <p class="mb-0 small text-muted" style="white-space: pre-line;">@a.Descripcion</p>
            </div>
            @* El admin puede eliminar cualquier anuncio; el profesor solo los suyos (el controlador lo vuelve a controlar) *@
            @if (esAdmin || a.ProfesorId == usuarioId)
            {
                <form asp-action="Delete" asp-route-id="@a.Id" method="post" data-confirmar="¿Está seguro que desea eliminar el anuncio @a.Titulo?">
                    <button type="submit" class="btn btn-sm btn-outline-danger">Eliminar</button>
                </form>
            }
        </div>
    }
    </div>
}
