@model List<AnuncioDto>
@{ ViewData["Title"] = "Anuncios"; }
<div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-4">
    <h1 class="mb-0">@(Context.Session.GetString("Rol") == "Profesor" ? "Mis anuncios" : "Anuncios publicados")</h1>
    <a asp-action="Create" class="btn btn-dark">+ Publicar anuncio</a>
</div>
@if (!Model.Any())
{
    <div class="alert alert-info">No hay anuncios publicados.</div>
}
else
{
    <table class="table table-striped table-hover align-middle">
        <thead><tr><th>Título</th><th>Descripción</th><th>Fecha</th><th class="text-end">Acciones</th></tr></thead>
        <tbody>
        @foreach (var a in Model)
        {
            <tr>
                <td><strong>@a.Titulo</strong></td>
                <td class="small">@a.Descripcion</td>
                <td>@a.FechaPublicacion.ToString("dd/MM/yyyy")</td>
                <td class="text-end">
                    <form asp-action="Delete" asp-route-id="@a.Id" method="post" class="d-inline" data-confirmar="¿Está seguro que desea eliminar el anuncio @a.Titulo?">
                        <button type="submit" class="btn btn-sm btn-danger">Eliminar</button>
                    </form>
                </td>
            </tr>
        }
        </tbody>
    </table>
}
