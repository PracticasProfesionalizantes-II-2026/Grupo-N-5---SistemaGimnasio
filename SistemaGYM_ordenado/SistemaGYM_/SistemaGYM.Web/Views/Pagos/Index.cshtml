@model List<PagoDto>
@{ ViewData["Title"] = "Reporte de pagos"; }
<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="mb-0 gym-titulo"><partial name="_Icono" model='"pagos"' />Reporte de pagos</h1>
    <a asp-action="Create" class="btn btn-dark">+ Registrar pago</a>
</div>

<form method="get" class="row g-2 mb-3">
    <div class="col-auto"><input type="date" name="fechaDesde" class="form-control" value="@ViewBag.FechaDesde" /></div>
    <div class="col-auto"><input type="date" name="fechaHasta" class="form-control" value="@ViewBag.FechaHasta" /></div>
    <div class="col-auto"><button type="submit" class="btn btn-outline-dark">Buscar</button></div>
</form>

@if (!Model.Any())
{
    <div class="alert alert-info">No hay pagos registrados en el rango seleccionado.</div>
}
else
{
    <table class="table table-striped table-hover align-middle">
        <thead><tr><th>Fecha</th><th>Monto</th><th>Método</th><th>Alumno ID</th><th class="text-end">Acciones</th></tr></thead>
        <tbody>
        @foreach (var p in Model)
        {
            <tr>
                <td>@p.FechaPago.ToString("dd/MM/yyyy")</td>
                <td>$@p.Monto</td>
                <td>@p.MetodoPago</td>
                <td>@p.AlumnoId</td>
                <td class="text-end">
                    <form asp-action="Delete" asp-route-id="@p.Id" method="post" class="d-inline" data-confirmar="¿Está seguro que desea eliminar este pago?">
                        <button type="submit" class="btn btn-sm btn-danger">Eliminar</button>
                    </form>
                </td>
            </tr>
        }
        </tbody>
    </table>
    <div class="text-end fw-bold">Total ingresado: $@ViewBag.TotalIngresado</div>
}
