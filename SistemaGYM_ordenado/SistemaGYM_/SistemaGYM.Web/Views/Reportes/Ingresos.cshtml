@model List<DatoMensual>
@{
    ViewData["Title"] = "Ingresos por mes";
    var cultura = new System.Globalization.CultureInfo("es-AR");
    var porMetodo = ViewBag.PorMetodo as List<DatoCategoria> ?? new();
    var total = (decimal)ViewBag.Total;
    var ultimoAnio = Model.Sum(d => d.Valor);
}
<h1 class="mb-2 gym-titulo"><partial name="_Icono" model='"ingresos"' />Ingresos por mes</h1>
<p class="text-muted mb-4">Total cobrado en cada uno de los últimos 12 meses, según los pagos registrados.</p>

<div class="gym-tarjeta mb-3">
    <div class="gym-dato-grande">@ultimoAnio.ToString("C0", cultura) <small>cobrados en el último año</small></div>
    <partial name="_BarrasMensuales" model="(Model, true)" />
</div>

<div class="gym-tarjeta mb-3">
    <h2 class="h5 mb-3">Por método de pago <small class="text-muted fw-normal">(todos los pagos: @total.ToString("C0", cultura))</small></h2>
    @if (!porMetodo.Any())
    {
        <p class="text-muted mb-0">Todavía no hay pagos registrados.</p>
    }
    else
    {
        <partial name="_BarrasCategorias" model="(porMetodo, true)" />
    }
</div>
<a asp-action="Index" class="btn btn-outline-dark">Volver</a>
