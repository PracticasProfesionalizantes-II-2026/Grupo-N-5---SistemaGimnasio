@model List<ActividadDto>
@{
    ViewData["Title"] = "Actividades";
    // Diccionario Id -> nombre, para mostrar el profesor en vez de su número
    var profesores = (ViewBag.Profesores as List<ProfesorDto> ?? new())
        .ToDictionary(p => p.Id, p => $"{p.Nombre} {p.Apellido}");
}

<div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-4">
    <h1 class="mb-0 gym-titulo"><partial name="_Icono" model='"actividades"' />Actividades registradas</h1>
    <a asp-action="Create" class="btn btn-dark">+ Crear actividad</a>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info">No hay actividades registradas todavía.</div>
}
else
{
    @* Cada actividad se muestra como una tarjeta con su horario, días y cupo *@
    <div class="row g-3">
    @foreach (var a in Model)
    {
        var porcentaje = a.Cupo == 0 ? 0 : Math.Min(100, (int)Math.Round(a.Inscriptos * 100.0 / a.Cupo));
        var llena = a.Inscriptos >= a.Cupo;
        <div class="col-md-6 col-lg-4">
            <div class="gym-ficha gym-ficha-actividad">
                <div class="d-flex justify-content-between align-items-start gap-2">
                    <strong class="fs-5">@a.Nombre</strong>
                    <span class="gym-horario">@a.HoraInicio.ToString("HH:mm") - @a.HoraFin.ToString("HH:mm")</span>
                </div>
                <div class="small text-muted mb-2">@(profesores.TryGetValue(a.ProfesorId, out var nombreProfesor) ? nombreProfesor : "Profesor dado de baja")</div>
                <div class="d-flex flex-wrap gap-1 mb-3">
                    @foreach (var dia in a.Dias.ToString().Split(", ")) { <span class="gym-chip">@dia</span> }
                </div>
                <div class="d-flex justify-content-between small mb-1">
                    <span>Cupo</span>
                    <span class="gym-cupo @(llena ? "lleno" : "")">@a.Inscriptos / @a.Cupo</span>
                </div>
                <div class="gym-progreso mb-3"><div class="gym-progreso-relleno @(llena ? "lleno" : "")" style="width: @(porcentaje)%"></div></div>
                <div class="d-flex flex-wrap gap-2">
                    <a asp-action="Alumnos" asp-route-id="@a.ActividadId" class="btn btn-sm btn-outline-primary">Ver alumnos</a>
                    <a asp-action="Edit" asp-route-id="@a.ActividadId" class="btn btn-sm btn-outline-secondary">Modificar</a>
                    <form asp-action="Delete" asp-route-id="@a.ActividadId" method="post" class="d-inline" data-confirmar="¿Está seguro que desea eliminar la actividad @a.Nombre del sistema?">
                        <button type="submit" class="btn btn-sm btn-danger">Eliminar</button>
                    </form>
                </div>
            </div>
        </div>
    }
    </div>
}
