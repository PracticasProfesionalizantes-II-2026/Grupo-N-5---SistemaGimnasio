@model List<ActividadDto>
@{ ViewData["Title"] = "Actividades"; }

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1>Actividades registradas</h1>
    <a asp-action="Create" class="btn btn-dark">+ Crear actividad</a>
</div>

@if (TempData["Mensaje"] != null) { <div class="alert alert-success">@TempData["Mensaje"]</div> }

@if (!Model.Any())
{
    <div class="alert alert-info">No hay actividades registradas todavía.</div>
}
else
{
    <table class="table table-striped table-hover align-middle">
        <thead><tr><th>Nombre</th><th>Horario</th><th>Días</th><th class="text-end">Acciones</th></tr></thead>
        <tbody>
        @foreach (var a in Model)
        {
            <tr>
                <td>@a.Nombre</td>
                <td>@a.HoraInicio.ToString("HH:mm") - @a.HoraFin.ToString("HH:mm")</td>
                <td>@a.Dias</td>
                <td class="text-end">
                    <a asp-action="Alumnos" asp-route-id="@a.ActividadId" class="btn btn-sm btn-outline-primary">Ver alumnos</a>
                    <a asp-action="Edit" asp-route-id="@a.ActividadId" class="btn btn-sm btn-outline-secondary">Modificar</a>
                    <form asp-action="Delete" asp-route-id="@a.ActividadId" method="post" class="d-inline" onsubmit="return confirm('¿Está seguro que desea eliminar la actividad @a.Nombre del sistema?');">
                        <button type="submit" class="btn btn-sm btn-danger">Eliminar</button>
                    </form>
                </td>
            </tr>
        }
        </tbody>
    </table>
}
