@model ActividadDto
@{
    ViewData["Title"] = "Modificar actividad";
    var profesores = ViewBag.Profesores as List<ProfesorDto> ?? new();
    var diasSeleccionados = Model.Dias.ToString().Split(", ");
}
<h1 class="mb-4">Modificar actividad</h1>
<form method="post" asp-action="Edit" asp-route-id="@Model.ActividadId">
    <div class="mb-3"><label class="form-label">Nombre</label><input type="text" name="nombre" class="form-control" value="@Model.Nombre" required /></div>
    <div class="mb-3"><label class="form-label">Descripción</label><textarea name="descripcion" class="form-control" required>@Model.Descripcion</textarea></div>
    <div class="row">
        <div class="col-md-4 mb-3"><label class="form-label">Hora inicio</label><input type="time" name="horaInicio" class="form-control" value="@Model.HoraInicio.ToString("HH:mm")" required /></div>
        <div class="col-md-4 mb-3"><label class="form-label">Hora fin</label><input type="time" name="horaFin" class="form-control" value="@Model.HoraFin.ToString("HH:mm")" required /></div>
        <div class="col-md-4 mb-3"><label class="form-label">Cupo (máx. alumnos)</label><input type="number" name="cupo" class="form-control" min="@Math.Max(1, Model.Inscriptos)" max="500" value="@Model.Cupo" required /><div class="form-text">Inscriptos actualmente: @Model.Inscriptos</div></div>
    </div>
    <div class="mb-3">
        <label class="form-label">Profesor</label>
        <select name="profesorId" class="form-select" required>
            @foreach (var p in profesores)
            {
                <option value="@p.Id" selected="@(p.Id == Model.ProfesorId)">@p.Nombre @p.Apellido</option>
            }
        </select>
    </div>
    <div class="mb-3">
        <label class="form-label">Días</label>
        <div>
            @foreach (var dia in new[] { "Lunes", "Martes", "Miercoles", "Jueves", "Viernes", "Sabado" })
            {
                <div class="form-check form-check-inline">
                    <input class="form-check-input" type="checkbox" name="dias" value="@dia" id="dia_@dia" checked="@diasSeleccionados.Contains(dia)">
                    <label class="form-check-label" for="dia_@dia">@dia</label>
                </div>
            }
        </div>
    </div>
    <button type="submit" class="btn btn-dark">Guardar cambios</button>
    <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
</form>
