@using SistemaGYM.Logica.DTOs
@{
    ViewData["Title"] = "Panel del profesor";
    var actividades = ViewBag.Actividades as List<ActividadDto> ?? new();
    var rutinas = ViewBag.Rutinas as List<RutinaDto> ?? new();
}
@* Menú principal del profesor (sin barra de navegación, ver _Layout) *@
<partial name="_EncabezadoMenu" />

<div class="gym-menu">
    <a class="gym-menu-tile" asp-action="Actividades">Mis actividades (@actividades.Count)<partial name="_Icono" model='"actividades"' /></a>
    <a class="gym-menu-tile" asp-action="Rutinas">Mis rutinas (@rutinas.Count)<partial name="_Icono" model='"rutinas"' /></a>
    <a class="gym-menu-tile" asp-action="Alimentaciones">Alimentación<partial name="_Icono" model='"alimentacion"' /></a>
    <a class="gym-menu-tile" asp-controller="Alumnos" asp-action="Index">Clientes<partial name="_Icono" model='"clientes"' /></a>
    <a class="gym-menu-tile" asp-controller="Anuncios" asp-action="Index">Anuncios<partial name="_Icono" model='"anuncios"' /></a>
</div>
