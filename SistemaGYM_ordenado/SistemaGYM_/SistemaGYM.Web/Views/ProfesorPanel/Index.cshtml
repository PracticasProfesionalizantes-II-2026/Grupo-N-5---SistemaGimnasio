@using SistemaGYM.Logica.DTOs
@{
    ViewData["Title"] = "Panel del profesor";
    var actividades = ViewBag.Actividades as List<ActividadDto> ?? new();
    var rutinas = ViewBag.Rutinas as List<RutinaDto> ?? new();
}
<h1 class="mb-2">Panel del profesor</h1>
<p class="text-muted mb-4">Gestioná tus actividades, rutinas, planes de alimentación y anuncios.</p>
<div class="row g-3 mb-4">
    <div class="col-6 col-md-4 col-lg-2"><a class="dashboard-tile" asp-action="Actividades">Mis actividades (@actividades.Count)</a></div>
    <div class="col-6 col-md-4 col-lg-2"><a class="dashboard-tile" asp-action="Rutinas">Mis rutinas (@rutinas.Count)</a></div>
    <div class="col-6 col-md-4 col-lg-2"><a class="dashboard-tile" asp-action="Alimentaciones">Alimentación</a></div>
    <div class="col-6 col-md-4 col-lg-2"><a class="dashboard-tile" asp-controller="Alumnos" asp-action="Index">Clientes</a></div>
    <div class="col-6 col-md-4 col-lg-2"><a class="dashboard-tile" asp-controller="Anuncios" asp-action="Index">Anuncios</a></div>
</div>
