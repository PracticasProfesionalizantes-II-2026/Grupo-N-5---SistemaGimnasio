@model List<RutinaDto>
@{ ViewData["Title"] = "Mis rutinas"; }
<div class="d-flex justify-content-between align-items-center mb-4"><h1>Rutinas asignadas por mí</h1><a asp-action="Actividades" class="btn btn-dark">+ Asignar desde una actividad</a></div>
@if (!Model.Any()) { <div class="alert alert-info">No tenés rutinas asignadas.</div> }
else { <table class="table table-striped"><thead><tr><th>Nombre</th><th>Actividad</th><th>Alumno</th><th>Descripción</th></tr></thead><tbody>@foreach (var r in Model) { <tr><td>@r.Nombre</td><td>@(r.ActividadNombre ?? "Sin actividad")</td><td>@(r.AlumnoNombre ?? $"#{r.AlumnoId}")</td><td>@r.Descripcion</td></tr> }</tbody></table> }
