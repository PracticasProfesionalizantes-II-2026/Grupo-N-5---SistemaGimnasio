@model List<RutinaDto>
@{ ViewData["Title"] = "Mis rutinas"; }
<div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-4">
    <h1 class="mb-0 gym-titulo"><partial name="_Icono" model='"rutinas"' />Rutinas creadas por mí</h1>
    <div class="d-flex flex-wrap gap-2">
        <a asp-action="Actividades" class="btn btn-outline-dark">Asignar desde una actividad</a>
        <a asp-controller="Rutinas" asp-action="Create" class="btn btn-dark">+ Crear rutina</a>
    </div>
</div>
@if (!Model.Any())
{
    <div class="alert alert-info">No tenés rutinas creadas.</div>
}
else
{
    @* Mismas tarjetas que ve el admin; al hacer clic se ve el detalle y se puede modificar o eliminar *@
    <div class="row g-3">
    @foreach (var r in Model)
    {
        <div class="col-md-6 col-lg-4">
            <partial name="_TarjetaRutina" model="r" />
        </div>
    }
    </div>
}
