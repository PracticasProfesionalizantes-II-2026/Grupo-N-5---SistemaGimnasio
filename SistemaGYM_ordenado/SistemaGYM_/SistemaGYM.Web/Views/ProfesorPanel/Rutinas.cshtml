@model List<RutinaDto>
@{ ViewData["Title"] = "Mis rutinas"; }
<div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-4">
    <h1 class="mb-0 gym-titulo"><partial name="_Icono" model='"rutinas"' />Rutinas asignadas por mí</h1>
    <a asp-action="Actividades" class="btn btn-dark">+ Asignar desde una actividad</a>
</div>
@if (!Model.Any())
{
    <div class="alert alert-info">No tenés rutinas asignadas.</div>
}
else
{
    <table class="table table-striped align-middle">
        <thead><tr><th>Nombre</th><th>Actividad</th><th>Alumno</th><th>Descripción</th><th class="text-end">Acciones</th></tr></thead>
        <tbody>
        @foreach (var r in Model)
        {
            <tr>
                <td><strong>@r.Nombre</strong></td>
                <td>@(r.ActividadNombre ?? "Sin actividad")</td>
                <td>@(r.AlumnoNombre ?? $"#{r.AlumnoId}")</td>
                <td class="small" style="white-space: pre-line;">@r.Descripcion</td>
                <td class="text-end text-nowrap">
                    <a asp-controller="Rutinas" asp-action="Edit" asp-route-id="@r.Id" class="btn btn-sm btn-outline-secondary">Modificar</a>
                    <form asp-controller="Rutinas" asp-action="Delete" asp-route-id="@r.Id" method="post" class="d-inline" data-confirmar="¿Está seguro que desea eliminar la rutina @r.Nombre?">
                        <button type="submit" class="btn btn-sm btn-danger">Eliminar</button>
                    </form>
                </td>
            </tr>
        }
        </tbody>
    </table>
}
