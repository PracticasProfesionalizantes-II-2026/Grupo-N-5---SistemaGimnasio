@model List<AlumnoInscriptoDto>
@{
    var actividad = ViewBag.Actividad as ActividadDto;
    ViewData["Title"] = "Alumnos inscriptos";
}
<h1 class="mb-2 gym-titulo"><partial name="_Icono" model='"clientes"' />Alumnos inscriptos: @actividad?.Nombre</h1>
<p class="text-muted mb-4">Cupo ocupado: @actividad?.Inscriptos de @actividad?.Cupo</p>

@if (!Model.Any(a => a.Activa))
{
    <div class="alert alert-info">No hay alumnos inscriptos actualmente.</div>
}
else
{
    <table class="table table-striped align-middle">
        <thead><tr><th>Alumno</th><th>Inscripción</th><th class="text-end">Acciones</th></tr></thead>
        <tbody>
        @foreach (var a in Model.Where(a => a.Activa))
        {
            <tr>
                <td><strong>@a.Nombre @a.Apellido</strong></td>
                <td>@a.FechaInscripcion.ToString("dd/MM/yyyy")</td>
                <td class="text-end text-nowrap">
                    <a asp-action="CrearAlimentacion" asp-route-alumnoId="@a.AlumnoId" class="btn btn-sm btn-outline-primary">Asignar alimentación</a>
                    <a asp-action="CrearRutina" asp-route-actividadId="@actividad?.ActividadId" class="btn btn-sm btn-outline-secondary">Asignar rutina</a>
                    <form asp-action="QuitarAlumno" method="post" class="d-inline" data-confirmar="¿Dar de baja a @a.Nombre @a.Apellido de esta actividad?">
                        <input type="hidden" name="actividadId" value="@actividad?.ActividadId" />
                        <input type="hidden" name="alumnoId" value="@a.AlumnoId" />
                        <button type="submit" class="btn btn-sm btn-outline-danger">Quitar</button>
                    </form>
                </td>
            </tr>
        }
        </tbody>
    </table>
}
<a asp-action="Actividades" class="btn btn-outline-dark">Volver</a>
