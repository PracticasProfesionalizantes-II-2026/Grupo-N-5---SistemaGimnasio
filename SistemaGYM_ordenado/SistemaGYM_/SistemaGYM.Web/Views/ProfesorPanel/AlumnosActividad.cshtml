@model List<AlumnoInscriptoDto>
@{ var actividad = ViewBag.Actividad as ActividadDto; ViewData["Title"] = "Alumnos inscriptos"; }
<h1 class="mb-4">Alumnos inscriptos: @actividad?.Nombre</h1>
@if (TempData["Mensaje"] != null) { <div class="alert alert-info">@TempData["Mensaje"]</div> }
@if (!Model.Any(a => a.Activa)) { <div class="alert alert-info">No hay alumnos inscriptos actualmente.</div> }
else { <table class="table table-striped align-middle"><thead><tr><th>Alumno</th><th>Inscripción</th><th>Alimentación</th><th>Rutina</th><th></th></tr></thead><tbody>@foreach (var a in Model.Where(a => a.Activa)) { <tr><td>@a.Nombre @a.Apellido</td><td>@a.FechaInscripcion.ToString("dd/MM/yyyy")</td><td><a asp-action="CrearAlimentacion" asp-route-alumnoId="@a.AlumnoId" class="btn btn-sm btn-outline-success">Asignar plan</a></td><td><a asp-action="CrearRutina" asp-route-actividadId="@actividad?.ActividadId" class="btn btn-sm btn-outline-primary">Asignar rutina</a></td><td><form asp-action="QuitarAlumno" method="post" class="d-inline" onsubmit="return confirm('¿Dar de baja al alumno de esta actividad?');"><input type="hidden" name="actividadId" value="@actividad?.ActividadId" /><input type="hidden" name="alumnoId" value="@a.AlumnoId" /><button type="submit" class="btn btn-sm btn-outline-danger">Quitar</button></form></td></tr> }</tbody></table> }
