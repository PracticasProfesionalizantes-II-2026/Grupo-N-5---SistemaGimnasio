@model List<ActividadDto>
@{ ViewData["Title"] = "Mis actividades"; }
<h1 class="mb-4 gym-titulo"><partial name="_Icono" model='"actividades"' />Mis actividades</h1>
@if (!Model.Any())
{
    <div class="alert alert-info">No tenés actividades asignadas.</div>
}
else
{
    @* Mismas tarjetas que ve el admin; el profesor no crea ni elimina actividades, pero gestiona sus alumnos *@
    <div class="row g-3">
    @foreach (var a in Model)
    {
        <div class="col-md-6 col-lg-4">
            <div class="gym-ficha gym-ficha-actividad">
                <partial name="_ActividadResumen" model="a" />
                <div class="d-flex flex-wrap gap-2">
                    <a asp-action="AlumnosActividad" asp-route-id="@a.ActividadId" class="btn btn-sm btn-outline-primary">Ver / inscribir alumnos</a>
                    <a asp-action="CrearRutina" asp-route-actividadId="@a.ActividadId" class="btn btn-sm btn-dark">Asignar rutina</a>
                </div>
            </div>
        </div>
    }
    </div>
}
