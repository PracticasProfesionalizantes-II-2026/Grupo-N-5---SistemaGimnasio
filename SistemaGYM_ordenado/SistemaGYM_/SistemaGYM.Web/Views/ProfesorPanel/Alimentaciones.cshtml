@model List<AlimentacionDto>
@{ ViewData["Title"] = "Alimentaciones asignadas"; }
<div class="d-flex justify-content-between align-items-center mb-4"><h1>Alimentaciones de mis alumnos</h1><a asp-action="CrearAlimentacion" class="btn btn-dark">+ Asignar alimentación</a></div>
@if (!Model.Any()) { <div class="alert alert-info">Todavía no asignaste planes de alimentación.</div> }
else { <table class="table table-striped"><thead><tr><th>Tipo</th><th>Alumno</th><th>Descripción</th></tr></thead><tbody>@foreach (var a in Model) { <tr><td>@a.TipoAlimentacion</td><td>@(a.AlumnoNombre ?? "Plan general")</td><td>@a.Descripcion</td></tr> }</tbody></table> }
