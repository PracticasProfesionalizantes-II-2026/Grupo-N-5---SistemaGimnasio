@{
    ViewData["Title"] = "Crear rutina";
    var alumnos = ViewBag.Alumnos as List<AlumnoDto> ?? new();
    var profesores = ViewBag.Profesores as List<ProfesorDto> ?? new();
}
<h1 class="mb-4">Crear rutina</h1>
<form method="post" asp-action="Create">
    <div class="mb-3"><label class="form-label">Nombre</label><input type="text" name="nombre" class="form-control" required /></div>
    <div class="mb-3">
        <label class="form-label">Descripción (ejercicios, series y repeticiones)</label>
        <textarea name="descripcion" class="form-control" rows="5" placeholder="Ej: Press militar 4 series de 12, 10 y 8 repeticiones" required></textarea>
    </div>
    <div class="mb-3">
        <label class="form-label">Profesor</label>
        <select name="profesorId" class="form-select" required>
            <option value="">-- Seleccionar --</option>
            @foreach (var p in profesores) { <option value="@p.Id">@p.Nombre @p.Apellido</option> }
        </select>
    </div>
    <div class="mb-3">
        <label class="form-label">Alumnos (podés elegir varios)</label>
        <div class="gym-lista-check">
            <div class="form-check border-bottom pb-2 mb-1">
                <input class="form-check-input" type="checkbox" id="todos" data-seleccionar-todos="alumnoIds" />
                <label class="form-check-label fw-semibold" for="todos">Seleccionar todos</label>
            </div>
            @foreach (var a in alumnos.OrderBy(a => a.Apellido))
            {
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" name="alumnoIds" value="@a.Id" id="@($"alumno_{a.Id}")" />
                    <label class="form-check-label" for="@($"alumno_{a.Id}")">@a.Apellido, @a.Nombre <span class="text-muted small">(DNI @a.Dni)</span></label>
                </div>
            }
        </div>
    </div>
    <button type="submit" class="btn btn-dark">Registrar rutina</button>
    <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
</form>
