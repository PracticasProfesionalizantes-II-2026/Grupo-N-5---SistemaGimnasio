@model List<RutinaDto>
@{
    ViewData["Title"] = "Rutinas";
    var profesores = (ViewBag.Profesores as List<ProfesorDto> ?? new())
        .ToDictionary(p => p.Id, p => $"{p.Nombre} {p.Apellido}");
}
<div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-4">
    <h1 class="mb-0 gym-titulo"><partial name="_Icono" model='"rutinas"' />Rutinas registradas</h1>
    <a asp-action="Create" class="btn btn-dark">+ Crear rutina</a>
</div>
@if (!Model.Any())
{
    <div class="alert alert-info">No hay rutinas cargadas todavía.</div>
}
else
{
    @* Cada rutina se muestra como una fila con borde naranja: nombre, a quién está asignada y quién la creó *@
    <div class="gym-lista-rutinas">
    @foreach (var r in Model)
    {
        <div class="gym-rutina">
            <div class="flex-grow-1">
                <strong>@r.Nombre</strong>
                <div class="d-flex flex-wrap gap-1 mt-1">
                    <span class="gym-chip">Alumno: @(r.AlumnoNombre ?? $"#{r.AlumnoId}")</span>
                    <span class="gym-chip">Profesor: @(profesores.TryGetValue(r.ProfesorId, out var nombreProfesor) ? nombreProfesor : $"#{r.ProfesorId}")</span>
                    @if (r.ActividadNombre != null) { <span class="gym-chip">@r.ActividadNombre</span> }
                </div>
            </div>
            <div class="text-nowrap">
                <a asp-action="Edit" asp-route-id="@r.Id" class="btn btn-sm btn-outline-secondary">Modificar</a>
                <form asp-action="Delete" asp-route-id="@r.Id" method="post" class="d-inline" data-confirmar="¿Está seguro que desea eliminar la rutina @r.Nombre del sistema?">
                    <button type="submit" class="btn btn-sm btn-danger">Eliminar</button>
                </form>
            </div>
        </div>
    }
    </div>
}
