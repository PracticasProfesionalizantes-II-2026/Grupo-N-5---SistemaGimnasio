@model List<RutinaDto>
@{
    ViewData["Title"] = "Rutinas";
    var profesores = (ViewBag.Profesores as List<ProfesorDto> ?? new())
        .ToDictionary(p => p.Id, p => $"{p.Nombre} {p.Apellido}");
}
<div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-4">
    <h1 class="mb-0">Rutinas registradas</h1>
    <a asp-action="Create" class="btn btn-dark">+ Crear rutina</a>
</div>
@if (!Model.Any())
{
    <div class="alert alert-info">No hay rutinas cargadas todavía.</div>
}
else
{
    <table class="table table-striped table-hover align-middle">
        <thead><tr><th>Nombre</th><th>Alumno</th><th>Profesor</th><th>Actividad</th><th class="text-end">Acciones</th></tr></thead>
        <tbody>
        @foreach (var r in Model)
        {
            <tr>
                <td><strong>@r.Nombre</strong></td>
                <td>@(r.AlumnoNombre ?? $"#{r.AlumnoId}")</td>
                <td>@(profesores.TryGetValue(r.ProfesorId, out var nombreProfesor) ? nombreProfesor : $"#{r.ProfesorId}")</td>
                <td>@(r.ActividadNombre ?? "-")</td>
                <td class="text-end text-nowrap">
                    <a asp-action="Edit" asp-route-id="@r.Id" class="btn btn-sm btn-outline-secondary">Modificar</a>
                    <form asp-action="Delete" asp-route-id="@r.Id" method="post" class="d-inline" data-confirmar="¿Está seguro que desea eliminar la rutina @r.Nombre del sistema?">
                        <button type="submit" class="btn btn-sm btn-danger">Eliminar</button>
                    </form>
                </td>
            </tr>
        }
        </tbody>
    </table>
}
