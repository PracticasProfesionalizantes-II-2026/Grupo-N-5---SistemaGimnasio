@model List<RutinaDto>
@{
    ViewData["Title"] = "Rutinas";
    var profesores = (ViewBag.Profesores as List<ProfesorDto> ?? new())
        .ToDictionary(p => p.Id, p => $"{p.Nombre} {p.Apellido}");
}
<div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-4">
    <h1 class="mb-0 gym-titulo"><partial name="_Icono" model='"rutinas"' />Rutinas registradas</h1>
    <a asp-action="Create" class="btn btn-dark">+ Crear rutina</a>
</div>
@if (!Model.Any())
{
    <div class="alert alert-info">No hay rutinas cargadas todavía.</div>
}
else
{
    @* Cada rutina es una tarjeta; al hacer clic se ve la descripción y se puede modificar o eliminar *@
    <div class="row g-3">
    @foreach (var r in Model)
    {
        var nombreProfesor = profesores.TryGetValue(r.ProfesorId, out var nombre) ? nombre : "Profesor dado de baja";
        <div class="col-md-6 col-lg-4">
            <partial name="_TarjetaRutina" model="r" view-data='new ViewDataDictionary(ViewData) { ["NombreProfesor"] = nombreProfesor }' />
        </div>
    }
    </div>
}
