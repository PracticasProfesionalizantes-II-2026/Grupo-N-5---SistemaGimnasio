@model List<RutinaDto>
@{ ViewData["Title"] = "Mis rutinas"; }
<h1 class="mb-4 gym-titulo"><partial name="_Icono" model='"rutinas"' />Mis rutinas</h1>
@if (!Model.Any())
{
    <div class="alert alert-info">Todavía no tenés rutinas asignadas. Consultá con tu profesor.</div>
}
else
{
    <div class="row g-3">
    @foreach (var r in Model)
    {
        <div class="col-md-6 col-lg-4">
            <partial name="_TarjetaRutina" model="r" />
        </div>
    }
    </div>
}
