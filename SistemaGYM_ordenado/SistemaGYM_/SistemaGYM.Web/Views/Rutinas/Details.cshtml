@model RutinaDto
@{
    ViewData["Title"] = Model.Nombre;
    var puedeGestionar = ViewBag.PuedeGestionar == true;
    var esAlumno = Context.Session.GetString("Rol") == "Alumno";
}
<h1 class="mb-2 gym-titulo"><partial name="_Icono" model='"rutinas"' />@Model.Nombre</h1>
<div class="d-flex flex-wrap gap-1 mb-4">
    <span class="gym-chip">Actividad: @(Model.ActividadNombre ?? "Sin actividad")</span>
    <span class="gym-chip">Profesor: @ViewBag.NombreProfesor</span>
</div>

<div class="gym-tarjeta mb-3" style="max-width: 820px;">
    <h5 class="mb-2">Ejercicios, series y repeticiones</h5>
    <p class="mb-0" style="white-space: pre-line;">@Model.Descripcion</p>
</div>

@if (!esAlumno)
{
    <div class="gym-tarjeta mb-3" style="max-width: 820px;">
        <h5 class="mb-2">Asignada a</h5>
        @if (Model.Alumnos.Count == 0)
        {
            <p class="mb-0 text-muted">Rutina general: la ven todos los alumnos.</p>
        }
        else
        {
            <div class="d-flex flex-wrap gap-1">
                @foreach (var alumno in Model.Alumnos) { <span class="gym-chip">@alumno.Nombre</span> }
            </div>
        }
    </div>
}

<div class="d-flex gap-2">
    @if (puedeGestionar)
    {
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-secondary">Modificar</a>
        <form asp-action="Delete" asp-route-id="@Model.Id" method="post" class="d-inline" data-confirmar="¿Está seguro que desea eliminar la rutina @Model.Nombre?">
            <button type="submit" class="btn btn-danger">Eliminar</button>
        </form>
    }
    @* Index redirige al listado que corresponde a cada rol *@
    <a asp-action="Index" class="btn btn-outline-dark">Volver</a>
</div>
