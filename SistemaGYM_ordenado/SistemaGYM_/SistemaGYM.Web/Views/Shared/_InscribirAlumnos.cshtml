@model List<AlumnoDto>
@*
    Formulario para inscribir uno o varios alumnos a una actividad (admin y profesor).
    Envía "actividadId" y "alumnoIds" a la acción InscribirAlumnos del controlador actual.
    El modelo son los alumnos que todavía no están inscriptos; la actividad sale de ViewBag.Actividad.
*@
@{
    var actividad = ViewData["Actividad"] as ActividadDto;
    var lugaresLibres = actividad == null ? 0 : actividad.Cupo - actividad.Inscriptos;
}
<div class="gym-ficha mb-4">
    <h5 class="mb-1">Inscribir alumnos</h5>
    <p class="text-muted small mb-3">Lugares libres: @(lugaresLibres < 0 ? 0 : lugaresLibres)</p>
    @if (lugaresLibres <= 0)
    {
        <div class="alert alert-warning mb-0">La actividad no tiene cupo disponible.</div>
    }
    else
    {
        <form asp-action="InscribirAlumnos" method="post">
            <input type="hidden" name="actividadId" value="@actividad?.ActividadId" />
            <div class="mb-3"><partial name="_ListaAlumnos" model="Model" /></div>
            @if (Model.Any())
            {
                <button type="submit" class="btn btn-dark">Inscribir seleccionados</button>
            }
        </form>
    }
</div>
