@model ActividadDto
@*
    Parte común de la tarjeta de una actividad: nombre, horario, profesor, días y cupo.
    La usan el admin, el profesor y el alumno; cada vista agrega debajo sus propios botones.
    ViewData["NombreProfesor"] es opcional (el profesor no lo necesita en sus propias actividades).
*@
@{
    var porcentaje = Model.Cupo == 0 ? 0 : Math.Min(100, (int)Math.Round(Model.Inscriptos * 100.0 / Model.Cupo));
    var llena = Model.Inscriptos >= Model.Cupo;
    var nombreProfesor = ViewData["NombreProfesor"] as string;
}
<div class="d-flex justify-content-between align-items-start gap-2">
    <strong class="fs-5">@Model.Nombre</strong>
    <span class="gym-horario">@Model.HoraInicio.ToString("HH:mm") - @Model.HoraFin.ToString("HH:mm")</span>
</div>
<div class="small text-muted mb-2">@nombreProfesor</div>
<div class="d-flex flex-wrap gap-1 mb-3">
    @foreach (var dia in Model.Dias.ToString().Split(", ")) { <span class="gym-chip">@dia</span> }
</div>
<div class="d-flex justify-content-between small mb-1">
    <span>Cupo</span>
    <span class="gym-cupo @(llena ? "lleno" : "")">@Model.Inscriptos / @Model.Cupo</span>
</div>
<div class="gym-progreso mb-3"><div class="gym-progreso-relleno @(llena ? "lleno" : "")" style="width: @(porcentaje)%"></div></div>
