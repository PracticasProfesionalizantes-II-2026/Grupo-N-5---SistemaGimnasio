@model List<AlumnoDto>
@*
    Lista de casillas para elegir uno o varios alumnos.
    Los elegidos se envían al controlador en el parámetro "alumnoIds" (List<int>).
    Se usa al crear actividades, inscribir alumnos y crear rutinas o planes de alimentación.
    Si el controlador deja ViewBag.AlumnoPreseleccionado, ese alumno aparece marcado.
*@
@{ var preseleccionado = ViewData["AlumnoPreseleccionado"] as int?; }
@if (!Model.Any())
{
    <div class="text-muted small">No hay alumnos disponibles.</div>
}
else
{
    <div class="gym-lista-check">
        <div class="form-check border-bottom pb-2 mb-1">
            <input class="form-check-input" type="checkbox" id="todos" data-seleccionar-todos="alumnoIds" />
            <label class="form-check-label fw-semibold" for="todos">Seleccionar todos</label>
        </div>
        @foreach (var a in Model.OrderBy(a => a.Apellido).ThenBy(a => a.Nombre))
        {
            <div class="form-check">
                <input class="form-check-input" type="checkbox" name="alumnoIds" value="@a.Id" id="@($"alumno_{a.Id}")" checked="@(a.Id == preseleccionado)" />
                <label class="form-check-label" for="@($"alumno_{a.Id}")">@a.Apellido, @a.Nombre <span class="text-muted small">(DNI @a.Dni)</span></label>
            </div>
        }
    </div>
}
