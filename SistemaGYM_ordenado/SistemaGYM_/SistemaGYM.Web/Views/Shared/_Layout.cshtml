<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - GYM+</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    @{
        var rol = Context.Session.GetString("Rol");
    }
    <header>
        <nav class="navbar navbar-expand-sm navbar-dark bg-dark mb-4">
            <div class="container-fluid">
                <a class="navbar-brand fw-bold" asp-controller="@(rol == "Administrador" ? "Admin" : "Cliente")" asp-action="Index">GYM+</a>
                @if (!string.IsNullOrEmpty(rol))
                {
                    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse">
                        <span class="navbar-toggler-icon"></span>
                    </button>
                    <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                        <ul class="navbar-nav flex-grow-1">
                            @if (rol == "Administrador")
                            {
                                <li class="nav-item"><a class="nav-link" asp-controller="Alumnos" asp-action="Index">Clientes</a></li>
                                <li class="nav-item"><a class="nav-link" asp-controller="Profesores" asp-action="Index">Profesores</a></li>
                                <li class="nav-item"><a class="nav-link" asp-controller="Actividades" asp-action="Index">Actividades</a></li>
                                <li class="nav-item"><a class="nav-link" asp-controller="Suscripciones" asp-action="Index">Suscripciones</a></li>
                                <li class="nav-item"><a class="nav-link" asp-controller="Pagos" asp-action="Index">Pagos</a></li>
                                <li class="nav-item"><a class="nav-link" asp-controller="Reportes" asp-action="Index">Reportes</a></li>
                                <li class="nav-item"><a class="nav-link" asp-controller="Rutinas" asp-action="Index">Rutinas</a></li>
                                <li class="nav-item"><a class="nav-link" asp-controller="Alimentacion" asp-action="Index">Alimentación</a></li>
                                <li class="nav-item"><a class="nav-link" asp-controller="Anuncios" asp-action="Index">Anuncios</a></li>
                            }
                            else
                            {
                                <li class="nav-item"><a class="nav-link" asp-controller="Clases" asp-action="Index">Clases</a></li>
                                <li class="nav-item"><a class="nav-link" asp-controller="MiSuscripcion" asp-action="Index">Suscripción</a></li>
                                <li class="nav-item"><a class="nav-link" asp-controller="Rutinas" asp-action="MisRutinas">Rutinas</a></li>
                                <li class="nav-item"><a class="nav-link" asp-controller="Alimentacion" asp-action="Index">Alimentación</a></li>
                                <li class="nav-item"><a class="nav-link" asp-controller="MisDatos" asp-action="Index">Mis Datos</a></li>
                                <li class="nav-item"><a class="nav-link" asp-controller="Anuncios" asp-action="Notificaciones">🔔 Notificaciones</a></li>
                            }
                        </ul>
                        <span class="navbar-text text-white me-3">
                            @Context.Session.GetString("Nombre") @Context.Session.GetString("Apellido")
                        </span>
                        <a class="btn btn-outline-light btn-sm" asp-controller="Auth" asp-action="Logout">Salir</a>
                    </div>
                }
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>
    <footer class="border-top footer text-muted mt-4">
        <div class="container">
            &copy; 2026 - GYM+
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
