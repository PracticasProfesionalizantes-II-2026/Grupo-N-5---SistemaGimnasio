<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - GYM+</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Inter:wght@400;500;600;700&display=swap" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    @{
        var rol = Context.Session.GetString("Rol");
        var controlador = ViewContext.RouteData.Values["controller"]?.ToString();
        var accion = ViewContext.RouteData.Values["action"]?.ToString();

        // Marca como "active" el link de la sección en la que está el usuario
        string Activo(string c, string? a = null) =>
            controlador == c && (a == null || accion == a) ? "active" : "";
    }
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark gym-navbar">
            <div class="container">
                <a class="navbar-brand gym-logo" asp-controller="@(rol == "Administrador" ? "Admin" : rol == "Profesor" ? "ProfesorPanel" : "Cliente")" asp-action="Index">GYM<span>+</span></a>
                @if (!string.IsNullOrEmpty(rol))
                {
                    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#menuPrincipal" aria-label="Abrir menú">
                        <span class="navbar-toggler-icon"></span>
                    </button>
                    <div class="collapse navbar-collapse" id="menuPrincipal">
                        <ul class="navbar-nav me-auto">
                            @if (rol == "Administrador")
                            {
                                <li class="nav-item"><a class="nav-link @Activo("Alumnos")" asp-controller="Alumnos" asp-action="Index">Clientes</a></li>
                                <li class="nav-item"><a class="nav-link @Activo("Profesores")" asp-controller="Profesores" asp-action="Index">Profesores</a></li>
                                <li class="nav-item"><a class="nav-link @Activo("Actividades")" asp-controller="Actividades" asp-action="Index">Actividades</a></li>
                                <li class="nav-item"><a class="nav-link @Activo("Suscripciones")" asp-controller="Suscripciones" asp-action="Index">Suscripciones</a></li>
                                <li class="nav-item"><a class="nav-link @Activo("Pagos")" asp-controller="Pagos" asp-action="Index">Pagos</a></li>
                                <li class="nav-item"><a class="nav-link @Activo("Reportes")" asp-controller="Reportes" asp-action="Index">Reportes</a></li>
                                <li class="nav-item"><a class="nav-link @Activo("Rutinas")" asp-controller="Rutinas" asp-action="Index">Rutinas</a></li>
                                <li class="nav-item"><a class="nav-link @Activo("Alimentacion")" asp-controller="Alimentacion" asp-action="Index">Alimentación</a></li>
                                <li class="nav-item"><a class="nav-link @Activo("Anuncios")" asp-controller="Anuncios" asp-action="Index">Anuncios</a></li>
                            }
                            else if (rol == "Profesor")
                            {
                                <li class="nav-item"><a class="nav-link @Activo("ProfesorPanel", "Actividades")" asp-controller="ProfesorPanel" asp-action="Actividades">Mis actividades</a></li>
                                <li class="nav-item"><a class="nav-link @Activo("ProfesorPanel", "Rutinas")" asp-controller="ProfesorPanel" asp-action="Rutinas">Mis rutinas</a></li>
                                <li class="nav-item"><a class="nav-link @Activo("ProfesorPanel", "Alimentaciones")" asp-controller="ProfesorPanel" asp-action="Alimentaciones">Alimentación</a></li>
                                <li class="nav-item"><a class="nav-link @Activo("Alumnos")" asp-controller="Alumnos" asp-action="Index">Clientes</a></li>
                                <li class="nav-item"><a class="nav-link @Activo("Anuncios")" asp-controller="Anuncios" asp-action="Index">Anuncios</a></li>
                            }
                            else
                            {
                                <li class="nav-item"><a class="nav-link @Activo("Clases")" asp-controller="Clases" asp-action="Index">Clases</a></li>
                                <li class="nav-item"><a class="nav-link @Activo("MiSuscripcion")" asp-controller="MiSuscripcion" asp-action="Index">Suscripción</a></li>
                                <li class="nav-item"><a class="nav-link @Activo("Rutinas")" asp-controller="Rutinas" asp-action="MisRutinas">Rutinas</a></li>
                                <li class="nav-item"><a class="nav-link @Activo("Alimentacion")" asp-controller="Alimentacion" asp-action="Index">Alimentación</a></li>
                                <li class="nav-item"><a class="nav-link @Activo("MisDatos")" asp-controller="MisDatos" asp-action="Index">Mis datos</a></li>
                                <li class="nav-item"><a class="nav-link @Activo("Anuncios")" asp-controller="Anuncios" asp-action="Notificaciones">Notificaciones</a></li>
                            }
                        </ul>
                        <div class="d-flex align-items-center gap-3">
                            <span class="gym-usuario">
                                @Context.Session.GetString("Nombre") @Context.Session.GetString("Apellido")
                                <small>@rol</small>
                            </span>
                            <a class="btn btn-sm btn-outline-light" asp-controller="Auth" asp-action="Logout">Salir</a>
                        </div>
                    </div>
                }
            </div>
        </nav>
    </header>

    <main role="main" class="container gym-main">
        @RenderBody()
    </main>

    <footer class="gym-footer">
        <div class="container">&copy; 2026 - GYM+</div>
    </footer>

    @* Ventanas de mensaje (éxito / error) y de confirmación que usan todas las páginas *@
    <partial name="_Mensajes" />

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
