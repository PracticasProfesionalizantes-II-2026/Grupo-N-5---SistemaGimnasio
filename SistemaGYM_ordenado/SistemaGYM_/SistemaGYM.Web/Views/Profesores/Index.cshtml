@model List<ProfesorDto>
@{ ViewData["Title"] = "Profesores"; }

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1>Profesores registrados</h1>
    <a asp-action="Create" class="btn btn-dark">+ Registrar profesor</a>
</div>


@if (!Model.Any())
{
    <div class="alert alert-info">No hay profesores cargados todavía.</div>
}
else
{
    <table class="table table-striped table-hover align-middle">
        <thead><tr><th>DNI</th><th>Nombre</th><th>Apellido</th><th>Email</th><th class="text-end">Acciones</th></tr></thead>
        <tbody>
        @foreach (var p in Model)
        {
            <tr>
                <td>@p.Dni</td><td>@p.Nombre</td><td>@p.Apellido</td><td>@p.Email</td>
                <td class="text-end">
                    <a asp-action="Details" asp-route-id="@p.Id" class="btn btn-sm btn-outline-primary">Ver detalle</a>
                    <a asp-action="Edit" asp-route-id="@p.Id" class="btn btn-sm btn-outline-secondary">Modificar</a>
                    <form asp-action="Delete" asp-route-id="@p.Id" method="post" class="d-inline" data-confirmar="¿Está seguro que desea eliminar al profesor @p.Nombre @p.Apellido del sistema?">
                        <button type="submit" class="btn btn-sm btn-danger">Eliminar</button>
                    </form>
                </td>
            </tr>
        }
        </tbody>
    </table>
}
