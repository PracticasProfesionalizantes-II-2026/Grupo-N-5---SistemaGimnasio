@model List<ProfesorDto>
@{
    ViewData["Title"] = "Profesores";
    var actividades = ViewBag.Actividades as List<ActividadDto> ?? new();
    var actividadId = ViewBag.ActividadId as int?;
    bool hayFiltros = !string.IsNullOrWhiteSpace(ViewBag.Buscar as string) || actividadId.HasValue;
}

<div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-4">
    <h1 class="mb-0 gym-titulo"><partial name="_Icono" model='"profesores"' />Profesores registrados</h1>
    <a asp-action="Create" class="btn btn-dark">+ Registrar profesor</a>
</div>

@* Buscador: los dos campos son opcionales y se pueden combinar *@
<form method="get" asp-action="Index" class="gym-filtros">
    <div class="row g-3 align-items-end">
        <div class="col-md-6">
            <label class="form-label">Buscar</label>
            <input type="search" name="buscar" value="@ViewBag.Buscar" class="form-control" placeholder="Nombre, apellido, DNI, email o descripción" />
        </div>
        <div class="col-md-4">
            <label class="form-label">Actividad a cargo</label>
            <select name="actividadId" class="form-select">
                <option value="">Todas</option>
                @foreach (var a in actividades.OrderBy(a => a.Nombre))
                {
                    <option value="@a.ActividadId" selected="@(a.ActividadId == actividadId)">@a.Nombre</option>
                }
            </select>
        </div>
        <div class="col-md-2 d-grid">
            <button type="submit" class="btn btn-dark">Buscar</button>
        </div>
    </div>
    @if (hayFiltros)
    {
        <div class="mt-2 small">
            @Model.Count resultado(s) · <a asp-action="Index">Limpiar filtros</a>
        </div>
    }
</form>

@if (!Model.Any())
{
    <div class="alert alert-info">@(hayFiltros ? "No se encontraron profesores con esos filtros." : "No hay profesores cargados todavía.")</div>
}
else
{
    @* Cada profesor se muestra como una tarjeta de perfil *@
    <div class="row g-3">
    @foreach (var p in Model)
    {
        var aCargo = actividades.Where(a => a.ProfesorId == p.Id).Select(a => a.Nombre).ToList();
        <div class="col-md-6 col-lg-4">
            <div class="gym-ficha gym-ficha-perfil">
                <span class="gym-avatar gym-avatar-grande">@($"{p.Nombre.FirstOrDefault()}{p.Apellido.FirstOrDefault()}")</span>
                <strong class="d-block mt-2">@p.Nombre @p.Apellido</strong>
                <div class="small text-muted">@p.Email · DNI @p.Dni</div>
                <div class="d-flex flex-wrap justify-content-center gap-1 my-3">
                    @if (aCargo.Any())
                    {
                        foreach (var nombre in aCargo) { <span class="gym-chip">@nombre</span> }
                    }
                    else
                    {
                        <span class="small text-muted">Sin actividades a cargo</span>
                    }
                </div>
                <div class="d-flex justify-content-center gap-2">
                    <a asp-action="Details" asp-route-id="@p.Id" class="btn btn-sm btn-outline-primary">Ver detalle</a>
                    <a asp-action="Edit" asp-route-id="@p.Id" class="btn btn-sm btn-outline-secondary">Modificar</a>
                    <form asp-action="Delete" asp-route-id="@p.Id" method="post" class="d-inline" data-confirmar="¿Está seguro que desea eliminar al profesor @p.Nombre @p.Apellido del sistema?">
                        <button type="submit" class="btn btn-sm btn-danger">Eliminar</button>
                    </form>
                </div>
            </div>
        </div>
    }
    </div>
}
