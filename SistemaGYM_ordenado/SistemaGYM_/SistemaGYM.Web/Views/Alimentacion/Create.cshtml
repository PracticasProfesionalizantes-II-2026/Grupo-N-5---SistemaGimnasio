@{
    ViewData["Title"] = "Crear plan de alimentación";
    var profesores = ViewBag.Profesores as List<ProfesorDto> ?? new();
}
<h1 class="mb-4">Crear plan de alimentación</h1>
<form method="post" asp-action="Create">
    <div class="mb-3"><label class="form-label">Tipo de alimentación</label><input type="text" name="TipoAlimentacion" class="form-control" required /></div>
    <div class="mb-3"><label class="form-label">Descripción</label><textarea name="Descripcion" class="form-control" rows="6" required></textarea></div>
    <div class="mb-3">
        <label class="form-label">Profesor responsable</label>
        <select name="ProfesorId" class="form-select" required>
            <option value="">-- Seleccionar --</option>
            @foreach (var p in profesores) { <option value="@p.Id">@p.Nombre @p.Apellido</option> }
        </select>
    </div>
    <button type="submit" class="btn btn-dark">Registrar plan</button>
    <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
</form>
