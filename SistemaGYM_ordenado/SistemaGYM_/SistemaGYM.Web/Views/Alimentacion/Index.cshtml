@model List<AlimentacionDto>
@{
    ViewData["Title"] = "Alimentación";
    var esAdmin = Context.Session.GetString("Rol") == "Administrador";
}
<div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-4">
    <h1 class="mb-0 gym-titulo"><partial name="_Icono" model='"alimentacion"' />Planes de alimentación</h1>
    @if (esAdmin)
    {
        <a asp-action="Create" class="btn btn-dark">+ Crear plan</a>
    }
</div>

@if (!Model.Any())
{
    <div class="alert alert-info">Todavía no hay planes de alimentación disponibles.</div>
}
else
{
    @* Cada plan es una tarjeta separada; al hacer clic se ve el detalle completo *@
    <div class="row g-3">
    @foreach (var a in Model)
    {
        <div class="col-md-6 col-lg-4">
            <a asp-action="Details" asp-route-id="@a.Id" class="gym-plan">
                <div class="d-flex justify-content-between align-items-start gap-2 mb-2">
                    <strong>@a.TipoAlimentacion</strong>
                    <span class="badge text-bg-light">@(a.AlumnoNombre ?? "Plan general")</span>
                </div>
                <p class="gym-plan-texto">@a.Descripcion</p>
                <span class="gym-plan-ver">Ver plan →</span>
            </a>
        </div>
    }
    </div>
}
