@model List<ActividadDto>
@{
    ViewData["Title"] = "Todas las clases";
    var inscriptas = ViewBag.ActividadesInscritas as HashSet<int> ?? new();
    var profesores = (ViewBag.Profesores as List<ProfesorDto> ?? new())
        .ToDictionary(p => p.Id, p => $"{p.Nombre} {p.Apellido}");
}
<div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-4">
    <h1 class="mb-0 gym-titulo"><partial name="_Icono" model='"clases"' />Clases disponibles</h1>
    <a asp-action="Index" class="btn btn-outline-dark">Volver a Mis Clases</a>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info">Todavía no hay clases disponibles.</div>
}
else
{
    <div class="row g-3">
    @foreach (var a in Model)
    {
        var nombreProfesor = profesores.TryGetValue(a.ProfesorId, out var nombre) ? nombre : "Profesor dado de baja";
        var sinCupo = a.Inscriptos >= a.Cupo;
        <div class="col-md-6 col-lg-4">
            <div class="gym-ficha gym-ficha-actividad">
                <partial name="_ActividadResumen" model="a" view-data='new ViewDataDictionary(ViewData) { ["NombreProfesor"] = nombreProfesor }' />
                <div class="d-flex flex-wrap align-items-center gap-2">
                    <a asp-action="Detalle" asp-route-id="@a.ActividadId" class="btn btn-sm btn-outline-primary">Ver detalle</a>
                    @if (inscriptas.Contains(a.ActividadId))
                    {
                        @* Ya inscripto: el botón se reemplaza por una tilde *@
                        <span class="gym-tilde" title="Ya estás inscripto">✓</span>
                    }
                    else if (sinCupo)
                    {
                        <button type="button" class="btn btn-sm btn-outline-secondary" disabled>Sin cupo</button>
                    }
                    else
                    {
                        <form asp-action="Inscribirse" method="post" class="d-inline">
                            <input type="hidden" name="actividadId" value="@a.ActividadId" />
                            <button type="submit" class="btn btn-sm btn-dark">Inscribirme</button>
                        </form>
                    }
                </div>
            </div>
        </div>
    }
    </div>
}
