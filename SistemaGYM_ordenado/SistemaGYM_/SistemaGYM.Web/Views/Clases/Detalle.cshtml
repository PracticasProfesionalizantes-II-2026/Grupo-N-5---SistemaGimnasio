@{
    ViewData["Title"] = "Detalle de la clase";
    var actividad = ViewBag.Actividad as ActividadDto;
    var profesor = ViewBag.Profesor as ProfesorDetalleDto;
}
<h1 class="mb-4 gym-titulo"><partial name="_Icono" model='"clases"' />@actividad?.Nombre</h1>
<p>@actividad?.Descripcion</p>
<p><strong>Horario:</strong> @actividad?.Dias, @actividad?.HoraInicio.ToString("HH:mm") a @actividad?.HoraFin.ToString("HH:mm")</p>

<div class="card mb-3" style="max-width:420px;">
    <div class="card-body">
        <h5 class="card-title">Profesor: @profesor?.Nombre @profesor?.Apellido</h5>
        <p class="card-text">@profesor?.Descripcion</p>
        <p class="card-text text-muted">@profesor?.Email</p>
    </div>
</div>

<p><strong>Alumnos anotados:</strong> @ViewBag.CantidadAlumnos de @actividad?.Cupo</p>

<div class="d-flex gap-2">
    @if (ViewBag.EstaInscripto == true)
    {
        <form asp-action="DarDeBaja" method="post" data-confirmar="¿Está seguro que desea darse de baja de esta actividad?">
            <input type="hidden" name="actividadId" value="@actividad?.ActividadId" />
            <button type="submit" class="btn btn-outline-danger">Darme de baja</button>
        </form>
    }
    <a asp-action="Index" class="btn btn-outline-dark">Volver</a>
</div>
