@{ ViewData["Title"] = "Registrar suscripción"; }
<h1 class="mb-4">Registrar suscripción</h1>
@if (ViewBag.Error != null) { <div class="alert alert-danger">@ViewBag.Error</div> }
<form method="post" asp-action="Create">
    <div class="mb-3"><label class="form-label">Nombre del plan</label><input type="text" name="Nombre" class="form-control" required /></div>
    <div class="mb-3"><label class="form-label">Precio</label><input type="number" step="0.01" name="Precio" class="form-control" required /></div>
    <div class="mb-3"><label class="form-label">Duración (días)</label><input type="number" name="DuracionDias" class="form-control" required /></div>
    <button type="submit" class="btn btn-dark">Registrar suscripción</button>
    <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
</form>
