@model List<SuscripcionDto>
@{ ViewData["Title"] = "Suscripciones"; }
<div class="d-flex justify-content-between align-items-center mb-4">
    <h1>Planes de suscripción</h1>
    <a asp-action="Create" class="btn btn-dark">+ Registrar suscripción</a>
</div>
@if (TempData["Mensaje"] != null) { <div class="alert alert-success">@TempData["Mensaje"]</div> }
@if (!Model.Any())
{
    <div class="alert alert-info">No hay planes de suscripción cargados.</div>
}
else
{
    <table class="table table-striped table-hover align-middle">
        <thead><tr><th>Nombre</th><th>Precio</th><th>Duración (días)</th><th class="text-end">Acciones</th></tr></thead>
        <tbody>
        @foreach (var s in Model)
        {
            <tr>
                <td>@s.Nombre</td><td>$@s.Precio</td><td>@s.DuracionDias</td>
                <td class="text-end">
                    <a asp-action="Edit" asp-route-id="@s.Id" class="btn btn-sm btn-outline-secondary">Modificar</a>
                    <form asp-action="Delete" asp-route-id="@s.Id" method="post" class="d-inline" onsubmit="return confirm('¿Está seguro que desea eliminar la suscripción @s.Nombre del sistema?');">
                        <button type="submit" class="btn btn-sm btn-danger">Eliminar</button>
                    </form>
                </td>
            </tr>
        }
        </tbody>
    </table>
}
