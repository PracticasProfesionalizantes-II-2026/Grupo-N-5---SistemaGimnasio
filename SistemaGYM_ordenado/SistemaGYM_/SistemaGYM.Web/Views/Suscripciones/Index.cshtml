@model List<SuscripcionDto>
@{
    ViewData["Title"] = "Suscripciones";
    var cultura = new System.Globalization.CultureInfo("es-AR");
    var clientesPorPlan = ViewBag.ClientesPorPlan as Dictionary<string, int> ?? new();
}
<div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-4">
    <h1 class="mb-0 gym-titulo"><partial name="_Icono" model='"suscripciones"' />Planes de suscripción</h1>
    <a asp-action="Create" class="btn btn-dark">+ Registrar suscripción</a>
</div>
@if (!Model.Any())
{
    <div class="alert alert-info">No hay planes de suscripción cargados.</div>
}
else
{
    @* Cada plan se muestra como una tarjeta de precio *@
    <div class="row g-3">
    @foreach (var s in Model)
    {
        var clientes = clientesPorPlan.TryGetValue(s.Nombre, out var cantidad) ? cantidad : 0;
        <div class="col-md-6 col-lg-4">
            <div class="gym-plan-precio">
                <div class="gym-plan-precio-nombre">@s.Nombre</div>
                <div class="gym-plan-precio-valor">@s.Precio.ToString("C0", cultura)<small>/mes</small></div>
                <ul class="gym-plan-precio-datos">
                    <li>@s.DiasPorSemana día(s) por semana</li>
                    <li>Vigencia de 1 mes</li>
                    <li>@clientes cliente(s) con este plan</li>
                </ul>
                <a asp-action="Alumnos" asp-route-id="@s.Id" class="btn btn-dark w-100 mb-2">Ver clientes</a>
                <div class="d-flex gap-2">
                    <a asp-action="Edit" asp-route-id="@s.Id" class="btn btn-sm btn-outline-secondary flex-fill">Modificar</a>
                    <form asp-action="Delete" asp-route-id="@s.Id" method="post" class="flex-fill" data-confirmar="¿Está seguro que desea eliminar la suscripción @s.Nombre del sistema?">
                        <button type="submit" class="btn btn-sm btn-danger w-100">Eliminar</button>
                    </form>
                </div>
            </div>
        </div>
    }
    </div>
}
