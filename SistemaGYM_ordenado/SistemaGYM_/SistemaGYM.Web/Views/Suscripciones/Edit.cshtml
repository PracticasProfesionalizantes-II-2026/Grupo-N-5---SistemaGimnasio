@model SuscripcionDto
@{ ViewData["Title"] = "Modificar suscripción"; }
<h1 class="mb-4 gym-titulo"><partial name="_Icono" model='"suscripciones"' />Modificar suscripción</h1>
<form method="post" asp-action="Edit" asp-route-id="@Model.Id">
    <div class="mb-3"><label class="form-label">Nombre del plan</label><input type="text" name="Nombre" class="form-control" value="@Model.Nombre" required /></div>
    <div class="mb-3"><label class="form-label">Precio</label><input type="number" step="0.01" name="Precio" class="form-control" value="@Model.Precio" required /></div>
    <div class="mb-3"><label class="form-label">Días por semana</label><input type="number" name="DiasPorSemana" min="1" max="7" class="form-control" value="@Model.DiasPorSemana" required /><div class="form-text">Todos los planes vencen un mes calendario después del alta.</div></div>
    <button type="submit" class="btn btn-dark">Guardar cambios</button>
    <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
</form>
