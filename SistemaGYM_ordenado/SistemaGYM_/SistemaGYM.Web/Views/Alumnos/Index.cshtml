@model List<AlumnoDto>

@{
    ViewData["Title"] = "Clientes";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1>Clientes registrados</h1>
    <a asp-action="Create" class="btn btn-dark">+ Registrar cliente</a>
</div>

@if (TempData["Mensaje"] != null)
{
    <div class="alert alert-success">@TempData["Mensaje"]</div>
}

@if (!Model.Any())
{
    <div class="alert alert-info">No hay clientes cargados todavía.</div>
}
else
{
    <table class="table table-striped table-hover align-middle">
        <thead>
            <tr>
                <th>DNI</th>
                <th>Nombre</th>
                <th>Apellido</th>
                <th class="text-end">Acciones</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var alumno in Model)
        {
            <tr>
                <td>@alumno.Dni</td>
                <td>@alumno.Nombre</td>
                <td>@alumno.Apellido</td>
                <td class="text-end">
                    <a asp-action="Details" asp-route-id="@alumno.Id" class="btn btn-sm btn-outline-primary">Ver detalle</a>
                    <a asp-action="Edit" asp-route-id="@alumno.Id" class="btn btn-sm btn-outline-secondary">Modificar</a>
                    <form asp-action="Delete" asp-route-id="@alumno.Id" method="post" class="d-inline" onsubmit="return confirm('¿Está seguro que desea eliminar al cliente @alumno.Nombre @alumno.Apellido del sistema?');">
                        <button type="submit" class="btn btn-sm btn-danger">Eliminar</button>
                    </form>
                </td>
            </tr>
        }
        </tbody>
    </table>
}
