@model AlumnoDetalleDto
@{
    ViewData["Title"] = "Mis Datos";
    var pagos = ViewBag.Pagos as List<PagoDto> ?? new();
    var planes = ViewBag.Planes as Dictionary<int, string> ?? new();
}
<h1 class="mb-4 gym-titulo"><partial name="_Icono" model='"misdatos"' />Mis Datos</h1>

<div class="row g-4">
    <div class="col-lg-6">
        <div class="gym-ficha">
            <dl class="row mb-3">
                <dt class="col-sm-4">Nombre</dt><dd class="col-sm-8">@Model.Nombre</dd>
                <dt class="col-sm-4">Apellido</dt><dd class="col-sm-8">@Model.Apellido</dd>
                <dt class="col-sm-4">DNI</dt><dd class="col-sm-8">@Model.Dni</dd>
                <dt class="col-sm-4">Dirección</dt><dd class="col-sm-8">@Model.Direccion</dd>
                <dt class="col-sm-4">Teléfono</dt><dd class="col-sm-8">@Model.Telefono</dd>
                <dt class="col-sm-4">Email</dt><dd class="col-sm-8">@Model.Email</dd>
                <dt class="col-sm-4">Suscripción</dt><dd class="col-sm-8">@Model.Suscripcion</dd>
            </dl>
            <a asp-action="Editar" class="btn btn-outline-secondary">Editar mis datos</a>
        </div>
    </div>

    @* Historial de pagos registrados por el gimnasio para este cliente *@
    <div class="col-lg-6">
        <div class="gym-ficha">
            <h5 class="mb-3">Mis pagos</h5>
            @if (!pagos.Any())
            {
                <div class="alert alert-info mb-0">Todavía no tenés pagos registrados.</div>
            }
            else
            {
                <table class="table table-sm table-striped align-middle mb-0">
                    <thead><tr><th>Fecha</th><th>Plan</th><th>Método</th><th class="text-end">Monto</th></tr></thead>
                    <tbody>
                    @foreach (var p in pagos)
                    {
                        <tr>
                            <td>@p.FechaPago.ToString("dd/MM/yyyy")</td>
                            <td>@(planes.TryGetValue(p.AlumnoSuscripcionId, out var plan) ? plan : "-")</td>
                            <td>@p.MetodoPago</td>
                            <td class="text-end">$@p.Monto</td>
                        </tr>
                    }
                    </tbody>
                </table>
            }
        </div>
    </div>
</div>
