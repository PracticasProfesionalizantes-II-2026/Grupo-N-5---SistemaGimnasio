@using SistemaGYM.Logica.DTOs;
@model List<SistemaGYM.Logica.DTOs.AlumnoDto>

@{
    ViewData["Title"] = "Alumnos";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1>Alumnos</h1>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info">No hay alumnos cargados todavía.</div>
}
else
{
    <table class="table table-striped table-hover align-middle">
        <thead>
            <tr>
                <th>DNI</th>
                <th>Nombre</th>
                <th>Apellido</th>
                <th class="text-end">Acciones</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var alumno in Model)
        {
            <tr>
                <td>@alumno.Dni</td>
                <td>@alumno.Nombre</td>
                <td>@alumno.Apellido</td>
                <td class="text-end">
                    <a asp-action="Details" asp-route-id="@alumno.Id" class="btn btn-sm btn-outline-primary">
                        Ver detalle
                    </a>
                </td>
            </tr>
        }
        </tbody>
    </table>
}
